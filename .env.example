# 本地开发环境变量（复制成 .env 使用；.env 已在 .gitignore 中，不会入库）
#
# 不配置也能跑：确定性审计、规则检查、合规红黄线都完整可用；
# 只是"法规证据 / 模型综合 / 联网"这三类能力会如实显示为不可用（unavailable / unable_to_assess）。

# 身份：fake = 本地演示（X-Demo-User，不连 PG）；pg = 真实账号（需要数据库）
SMART_EDIT_AUTH_MODE=fake

# 抽取模型：默认不配置。配置 `fixture:` 会让任何文本都回放同一份样例保函（Alpha Tech /
# BG-2026-00417），审计看起来「读到了文档」，其实没有。模板一致性审计走 config 里的确定性抽取档
# （app/configs/conformance/*.yaml 的 extraction_profile），只有显式回放演示时才设置下面这行。
# SMART_EDIT_LLM=fixture:fixtures/llm/extract_sample.json

# 模板一致性审计的脱敏模式：basic（默认，按固定模式遮蔽账号/卡号/IBAN/BIC/邮箱/电话/证件号）| off
SMART_EDIT_CONFORMANCE_REDACT=basic
# 单次模型调用超时（秒）
# SMART_EDIT_CONFORMANCE_TIMEOUT=60

# ── 可选：豆包 / 火山方舟 Ark（法规结论的"综合"与联网要用它）────────────────
# SMART_EDIT_ASSISTANT_MODEL=doubao:doubao-seed-2-1-lite-260915
# SMART_EDIT_ASSISTANT_API_KEY=
# SMART_EDIT_ASSISTANT_PROCESSOR_APPROVED=1
# SMART_EDIT_ASSISTANT_GENERAL_WEB=1
# SMART_EDIT_ASSISTANT_WEB_SEARCH_MAX_KEYWORD=3
# SMART_EDIT_ASSISTANT_THINKING=1          # 打开隐藏推理（更慢、更强）

# ── 可选：法规语料（Mercatoria / RAGFlow）────────────────────────────────
# SMART_EDIT_STATUTE=1
# MERCATORIA_BASE_URL=http://127.0.0.1:8080
# MERCATORIA_API_TOKEN=

# ── 可选：真实账号模式（pg）才需要 ───────────────────────────────────────
# SMART_EDIT_DATABASE_URL=postgresql://user:password@127.0.0.1:15432/team04
# SMART_EDIT_AUTH_POOL_MIN=1
# SMART_EDIT_AUTH_POOL_MAX=5

# ── 可选：法规风险扫描 ───────────────────────────────────────────────────
# SMART_EDIT_LEGAL_WEB_DEFAULT=0           # 联网默认关（面板勾选优先）
# SMART_EDIT_LEGAL_MAX_CLAUSES=12
# SMART_EDIT_LEGAL_SCAN_DEADLINE=90

# ── 可选：自动化下游（Automation → Server & Downstream）──────────────────
# 允许 dispatch 的主机（逗号分隔）；不设置 = 全部拒绝（fail closed）。
# 本地演示：先跑 .venv/bin/python scripts/echo_downstream.py --port 18080
# SMART_EDIT_AUTOMATION_ALLOWED_HOSTS=127.0.0.1
# SMART_EDIT_AUTOMATION_ALLOW_HTTP=1       # 仅内网/演示；生产只留 https
# 连接器密钥只填"环境变量名"，值放在这里或系统环境里：
# DEMO_DOWNSTREAM_TOKEN=demo-token-123