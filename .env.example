# smart-edit POC — copy to .env (the app does not load it automatically; export the variables)
#
# Model provider for `extract` (the only model entry point).
#   unset                     -> extract is `failed` (honest: never guess candidates)
#   fixture:<path>            -> deterministic replay; the stage reason names the fixture
#   openai:<model>            -> reserved; no SDK is installed in this build
SMART_EDIT_LLM=

# Durable control plane
SMART_EDIT_CHECKPOINT_DB=runs/checkpoints.sqlite
SMART_EDIT_LEDGER_DB=runs/ledger.sqlite
SMART_EDIT_EXPORT_DIR=data/exports
OPENSPEC_DIR=openspec

# Agent 3 retrieval
#   URL  -> external HTTP retrieval service
#   off  -> disable retrieval explicitly (coverage.unavailable, never "no issue")
SMART_EDIT_RAG=
SMART_EDIT_RAG_CONFIG=data/regulatory/config.json
SMART_EDIT_RAG_KEYWORD_ONLY=0
SMART_EDIT_ANSWERER=extractive
SMART_EDIT_ANSWER_BASE=
SMART_EDIT_ANSWER_MODEL=
SMART_EDIT_ANSWER_API_KEY=

# POC only. Production must sign trail entries with a managed key.
TRAIL_SIGNING_KEY=
