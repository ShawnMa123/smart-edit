# 生产/演示环境变量模板 —— 复制成 deploy/env.ecs 后再改（deploy/env.ecs 已被 gitignore）。
# deploy/deploy.sh 会把它上传为 ECS 上的 /opt/smart-edit/.env（权限 600）。

# ---- 抽取模型：沿用仓库内 fixture，保证演示可复现 ----
SMART_EDIT_LLM=fixture:fixtures/llm/extract_sample.json

# ---- 身份：真实账号（PG）。ECS 与 RDS 同地域，直连内网地址，无需 SSH 隧道 ----
SMART_EDIT_AUTH_MODE=pg
SMART_EDIT_DATABASE_URL=postgresql://<user>:<password>@<rds-host>:5432/team04
SMART_EDIT_AUTH_POOL_MIN=1
SMART_EDIT_AUTH_POOL_MAX=5
# 当前通过 http://IP:8082 访问，没有 TLS：cookie 不能带 Secure，否则浏览器不会回传会话。
# 以后挂上 HTTPS 时删掉这一行（SMART_EDIT_ENV=production 默认就是 Secure）。
SMART_EDIT_ENV=production
SMART_EDIT_AUTH_COOKIE_SECURE=0

# ---- 运行期数据落在 /opt/smart-edit/data（不要放进 runs/ 之外，便于备份）----
SMART_EDIT_HOST_DB=/opt/smart-edit/data/host.db
SMART_EDIT_ASSISTANT_DB=/opt/smart-edit/data/assistant.db

# ---- 知识助手（豆包 / 火山方舟）----
SMART_EDIT_ASSISTANT_MODEL=doubao:doubao-seed-2-1-lite-260915
SMART_EDIT_ASSISTANT_API_KEY=<ark-api-key>
SMART_EDIT_ASSISTANT_PROCESSOR_APPROVED=1
SMART_EDIT_ASSISTANT_GENERAL_WEB=1
SMART_EDIT_ASSISTANT_WEB_SEARCH_MAX_KEYWORD=3

# ---- 法规检索：Mercatoria 就在同一台 ECS 的 8080（docker），走回环地址 ----
SMART_EDIT_STATUTE=1
MERCATORIA_BASE_URL=http://127.0.0.1:8080
MERCATORIA_API_TOKEN=<mercatoria-token>

# ---- 法规风险扫描（Legal → Document check）----
# 联网补检默认关闭，由用户在面板里勾选。
SMART_EDIT_LEGAL_WEB_DEFAULT=0
SMART_EDIT_LEGAL_MAX_CLAUSES=12
SMART_EDIT_LEGAL_SCAN_DEADLINE=90

SMART_EDIT_LOG_LEVEL=INFO